# Copiá este archivo a .env y completá los valores.

# --- Email (SMTP) ---
# Con Gmail: activá verificación en 2 pasos y generá una "contraseña de
# aplicación" en myaccount.google.com/apppasswords — la contraseña normal
# de tu cuenta de Gmail NO sirve acá si tenés 2FA (y conviene tenerlo).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# De dónde sale el mail. Si lo dejás vacío, usa SMTP_USER.
EMAIL_FROM=
# A quién le llega. Podés poner varias direcciones separadas por coma.
EMAIL_TO=

# Opcional: umbral mínimo de baja (%) para que valga la pena avisar
MIN_DROP_PERCENT=3

# Opcional: ventana de días para detectar "descuentos" falsos
FAKE_DISCOUNT_WINDOW_DAYS=90

# Opcional: dónde vive la base de datos SQLite
PRICEWATCHER_DB=data/pricewatcher.db
