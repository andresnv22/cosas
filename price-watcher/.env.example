# Copiá este archivo a .env y completá los valores.
# Conseguí el token hablando con @BotFather en Telegram (/newbot).
TELEGRAM_BOT_TOKEN=

# Se completa solo la primera vez que corrés el bot y le mandás /start
# (te va a devolver tu chat_id). Hace falta configurarlo acá para que el
# checker automático (cron) sepa a quién avisarle sin que haya una
# conversación activa.
TELEGRAM_CHAT_ID=

# Opcional: umbral mínimo de baja (%) para que valga la pena avisar
MIN_DROP_PERCENT=3

# Opcional: ventana de días para detectar "descuentos" falsos
FAKE_DISCOUNT_WINDOW_DAYS=90

# Opcional: dónde vive la base de datos SQLite
PRICEWATCHER_DB=data/pricewatcher.db
