# URL pública .ics de tu calendario de Google (Configuración del calendario
# → "Integrar calendario" → "Dirección pública en formato iCal")
CALENDAR_ICS_URL=

# Coordenadas para el clima (default: Bogotá)
LATITUDE=4.7110
LONGITUDE=-74.0721

# Token simple para que el endpoint no quede abierto a cualquiera en internet.
# Inventate una cadena random y ponela también en firmware/wall_panel/config.h
PANEL_TOKEN=

TASKS_PATH=data/tasks.json
